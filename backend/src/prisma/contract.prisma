// use prisma-8

model User {
    id                  String              @id @default(uuid())
    email               String              @unique
    passwordHash        String
    username            String              @unique
    realName            String
    createdAt           DateTime            @default(now())

    pins                Pin[]
    groupsOwned         Group[]             @relation("GroupOwner")
    memberships         GroupMember[]
    pinSharesReceived   PinShareUser[]

    friendshipSent      Friendship[]        @relation("FriendshipRequester")
    friendshipReceived  Friendship[]        @relation("FriendshipAddressee")
}

model Group {
    id                  String              @id @default(uuid())
    name                String
    ownerId             String
    owner               User                @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)

    members             GroupMember[]
    pinShares           PinShareGroup[]
}

model Pin {
    id                  String              @id @default(uuid())
    lat                 Float
    long                Float
    note                String?
    createdAt           DateTime            @default(now())

    ownerId             String
    owner               User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)

    sharedWithUsers     PinShareUser[]
    sharedWithGroups    PinShareGroup[]
}

model GroupMember {
    groupId             String
    userId              String
    
    group               Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
    user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)

    @@id([groupId, userId])
}

model PinShareUser {
    pinId               String
    userId              String
    createdAt           DateTime            @default(now())

    pin                 Pin                 @relation(fields: [pinId], references: [id], onDelete: Cascade)
    user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([pinId, userId])
}

model PinShareGroup {
    pinId               String
    groupId             String
    createdAt           DateTime            @default(now())

    pin                 Pin                 @relation(fields: [pinId], references: [id], onDelete: Cascade)
    group               Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)

    @@id([pinId, groupId])
}

model Friendship {
    id                  String              @id @default(uuid())
    requesterId         String
    addresseeId         String
    status              FriendshipStatus    @default(PENDING)
    createdAt           DateTime            @default(now())

    requester           User                @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    addressee           User                @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

    @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
    PENDING
    ACCEPTED
}