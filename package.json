    "expo": "~57.0.17",
    "expo-constants": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
